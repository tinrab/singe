cuda_path := "$CUDA_PATH"
cufft_include_path := "$CUFFT_INCLUDE_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    num_enums=(
        "libraryPropertyType_t"
        "cufftResult_t"
        "cufftType_t"
        "cufftCompatibility_t"
        "cufftProperty_t"
    )
    enum_args=$(for enum in "${num_enums[@]}"; do echo -n "--with-derive-custom $enum=TryFromPrimitive,IntoPrimitive "; done)

    bindgen {{cufft_include_path}}/cufft.h \
        $enum_args \
        --allowlist-item "^cufft.*" \
        --allowlist-item "^CUFFT.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^libraryPropertyType.*" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=rust \
        -- \
            -I {{cuda_path}}/include \
            -I {{cufft_include_path}} \
        > bindings.rs

    CUFFT_VERSION=$(cat bindings.rs | grep "CUFFT_VERSION" | awk '{ print $6 }' | sed 's/.$//')
    if [ -z "${CUFFT_VERSION}" ]; then
        echo "CUFFT_VERSION is empty"
        exit 1
    fi

    mv bindings.rs ./src/sys_${CUFFT_VERSION}.rs

    bindgen {{cufft_include_path}}/cufft_device.h \
        --allowlist-item "^(cufft(Device|Description).*|CUFFT_(DESC|DEVICE).*)$" \
        --blocklist-item "^cufft(Result|Handle|Type).*" \
        --blocklist-item "^cuda(Stream|DataType).*" \
        --blocklist-item "^libraryPropertyType.*" \
        --no-size_t-is-usize --no-layout-tests --with-derive-default \
        --with-derive-eq --with-derive-hash --use-core --default-enum-style=rust \
        -- -x c++ -DCUFFT_ENABLE_EXPERIMENTAL_API -I {{cuda_path}}/include -I {{cufft_include_path}} \
        > ./src/device_${CUFFT_VERSION}.rs

    bindgen {{cufft_include_path}}/cufftXt.h \
        --allowlist-item "^(cufftXt.*|CUFFT_.*|cudaLibXt.*|cudaXt.*|CUDA_XT.*)$" \
        --blocklist-item "^cufft(Result|Handle|Type).*" \
        --blocklist-item "^cuda(Stream|DataType).*" \
        --blocklist-item "^libraryPropertyType.*" \
        --no-size_t-is-usize --no-layout-tests --with-derive-default \
        --with-derive-eq --with-derive-hash --use-core --default-enum-style=rust \
        --  -I {{cuda_path}}/include -I {{cufft_include_path}} \
        > ./src/xt_${CUFFT_VERSION}.rs

clean:
    rm -rf ./dist
    rm -f ./src/sys_*.rs ./src/device_*.rs ./src/xt_*.rs
