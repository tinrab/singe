nvml_include_path := "$NVML_INCLUDE_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    bindgen {{ nvml_include_path }}/nvml.h \
        --allowlist-item "^nvml.*" \
        --allowlist-item "^NVML.*" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -fparse-all-comments \
            -I {{ nvml_include_path }} \
        > bindings.rs

    NVML_VERSION=$(grep -m1 -Eo 'NVML_API_VERSION[^=]*=[[:space:]]*[0-9]+' bindings.rs | grep -Eo '[0-9]+' | tail -n1)
    if [ -z "${NVML_VERSION}" ]; then
        echo "NVML_API_VERSION not found in bindings.rs"
        exit 1
    fi

    mv bindings.rs ./src/nvml_sys_${NVML_VERSION}.rs
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { LIBRARY;/' ./src/nvml_sys_${NVML_VERSION}.rs

clean:
    rm -rf ./dist
    rm -f ./src/nvml_sys_*.rs
