// The stream decoding steps run on, which orders with the legacy stream that copies use.
static cudaStream_t loop_stream = nullptr;
static bool use_graphs = false;

// A step replayed as a CUDA graph: it runs on the stream the first time, so libraries finish what they set up lazily, is captured the second time, and replays after that.
// A step that cannot be captured runs on the stream from then on.
struct StepGraph {
    int runs = 0;
    bool direct = false;
    cudaGraphExec_t exec = nullptr;
};

template <typename Run>
static int launch(StepGraph& graph, Run run) {
    if (!use_graphs || graph.direct || graph.runs++ == 0) return run();
    if (graph.exec == nullptr) {
        cudaGraph_t captured = nullptr;
        if (cudaStreamBeginCapture(loop_stream, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
            (void)cudaGetLastError();
            graph.direct = true;
            return run();
        }
        const int status = run();
        const cudaError_t ended = cudaStreamEndCapture(loop_stream, &captured);
        if (status != 0 || ended != cudaSuccess || cudaGraphInstantiate(&graph.exec, captured, 0) != cudaSuccess) {
            (void)cudaGetLastError();
            if (captured != nullptr) cudaGraphDestroy(captured);
            graph.exec = nullptr;
            graph.direct = true;
            fprintf(stderr, "a step could not be captured as a CUDA graph, and runs on the stream\n");
            return run();
        }
        cudaGraphDestroy(captured);
    }
    return static_cast<int>(cudaGraphLaunch(graph.exec, loop_stream));
}

