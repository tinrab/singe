// Captures the steps as `graph`'s executable graph, or returns false, with the error cleared, when they cannot be captured.
static bool singe_capture(@prefix@_state* s, singe_graph* graph, const @prefix@_inputs* inputs, const @prefix@_outputs* outputs) {
    cudaStream_t stream = s->replay.stream;
    if (cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
        (void)cudaGetLastError();
        return false;
    }
    cudaGraph_t captured = nullptr;
    const int status = singe_steps(s, inputs, outputs, stream);
    const bool ended = cudaStreamEndCapture(stream, &captured) == cudaSuccess;
    const bool instantiated = status == 0 && ended && cudaGraphInstantiate(&graph->exec, captured, 0) == cudaSuccess;
    if (captured != nullptr) cudaGraphDestroy(captured);
    if (!instantiated) {
        (void)cudaGetLastError();
        graph->exec = nullptr;
    }
    return instantiated;
}

// Runs the steps on the replay stream as `graph` says: launching each step, capturing the graph, or replaying it.
static int singe_run_graph(@prefix@_state* s, singe_graph* graph, const @prefix@_inputs* inputs, const @prefix@_outputs* outputs) {
    cudaStream_t stream = s->replay.stream;
    if (graph->direct || !graph->warmed) {
        graph->warmed = true;
        return singe_steps(s, inputs, outputs, stream);
    }
    if (graph->exec == nullptr && !singe_capture(s, graph, inputs, outputs)) {
        graph->direct = true;
        return singe_steps(s, inputs, outputs, stream);
    }
    singe_step = "replaying a run";
    SINGE_CHECK(cudaGraphLaunch(graph->exec, stream));
    return 0;
}

static int singe_run(@prefix@_state* s, const @prefix@_inputs* inputs, const @prefix@_outputs* outputs, cudaStream_t stream) {
    const void* key[SINGE_REPLAY_KEY] = {@key@};
    singe_graph* graph = singe_graph_for(&s->replay, key);
    singe_step = "starting a run";
    SINGE_CHECK(cudaEventRecord(s->replay.entered, stream));
    SINGE_CHECK(cudaStreamWaitEvent(s->replay.stream, s->replay.entered, 0));
    const int status = singe_run_graph(s, graph, inputs, outputs);
    if (status != 0) return status;
    singe_step = "ending a run";
    SINGE_CHECK(cudaEventRecord(s->replay.left, s->replay.stream));
    SINGE_CHECK(cudaStreamWaitEvent(stream, s->replay.left, 0));
    return 0;
}
