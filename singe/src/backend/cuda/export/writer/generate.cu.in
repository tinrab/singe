// Where `PageTable` places one sequence's tokens: positions fill pages from page zero, `page_size` slots each.
static const int64_t page_size = @page_size@;
static const int64_t capacity = @capacity@;
static const int64_t table_length = @table_length@;

static void check(int status, const char* what) {
