// Generated by Singe.
// Generates through `@prefix@.h` with nothing else, as Singe's `RunningBatch` does: each row reads a prompt, then the token the program chose after each step, until a stop token or NEW_TOKENS tokens, and a free row takes the next prompt.
// Run it as `@prefix@_generate @usage@` beside `@prefix@.weights`.
// The prompt is its tokens, or `--prompts FILE` for a file of prompts, one per line; a token written `TOKEN*` stands for as many copies as the encode step gives its source rows.
// One prompt prints a token per line, and several print each token after its prompt's number, from zero.
// `--seed N` starts the draws of a program that samples, zero if it is not given.
// A model with an encode step reads SOURCE, a file of its input's bytes, encodes it once, and then decodes one prompt.
#include <cuda_fp16.h>
#include <cuda_runtime.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <algorithm>
#include <string>
#include <vector>

#include "@prefix@.h"

// Where `PageTable` places tokens: each sequence takes free pages of `page_size` slots, and held rows and padding write the scratch page after them.
static const int64_t sequences = @sequences@;
static const int64_t page_size = @page_size@;
static const int64_t capacity = @capacity@;
static const int64_t scratch_page = @scratch_page@;
static const int64_t table_length = @table_length@;
// The most prompt tokens a step reads past one per row, and that step's rows.
static const int64_t largest = @largest@;
static const int64_t prompt_rows = @prompt_rows@;
// The tokens that end a sequence, which it prints as its last.
static const std::vector<int64_t> stop_tokens = {@stop_tokens@};

static void check(int status, const char* what) {
    if (status != 0) {
        fprintf(stderr, "%s returned %d: %s\n", what, status, @prefix@_failure());
        exit(1);
    }
}

static void check_cuda(cudaError_t status, const char* what) {
    if (status != cudaSuccess) {
        fprintf(stderr, "%s failed: %s\n", what, cudaGetErrorString(status));
        exit(1);
    }
}

static void* device_zeroed(unsigned long long bytes) {
    void* pointer = nullptr;
    if (bytes > 0) {
        check_cuda(cudaMalloc(&pointer, bytes), "cudaMalloc");
        check_cuda(cudaMemset(pointer, 0, bytes), "cudaMemset");
    }
    return pointer;
}

static void upload(void* buffer, const std::vector<int64_t>& values) {
    check_cuda(cudaMemcpy(buffer, values.data(), values.size() * sizeof(int64_t), cudaMemcpyHostToDevice), "cudaMemcpy");
}

// Reads `bytes` bytes of `path`, or with `exact` false up to that many.
static std::vector<char> read_file(const char* path, unsigned long long bytes, bool exact = true) {
    std::vector<char> contents(bytes);
    FILE* file = fopen(path, "rb");
    const size_t read = file == nullptr ? 0 : fread(contents.data(), 1, bytes, file);
    if (file == nullptr || (exact && read != bytes)) {
        fprintf(stderr, "cannot read %llu bytes from %s\n", bytes, path);
        exit(1);
    }
    fclose(file);
    contents.resize(read);
    return contents;
}

// A prompt's tokens, and where its starred token stands, if it has one.
struct Prompt {
    std::vector<int64_t> tokens;
    int64_t placeholder = -1;
    size_t placeholder_at = 0;
};

static void add_token(Prompt& prompt, const char* text) {
    char* end = nullptr;
    const int64_t token = strtoll(text, &end, 10);
    if (*end == '*') {
        prompt.placeholder = token;
        prompt.placeholder_at = prompt.tokens.size();
    } else {
        prompt.tokens.push_back(token);
    }
}

static std::vector<Prompt> read_prompts(const char* path) {
    std::vector<Prompt> prompts;
    FILE* file = fopen(path, "r");
    if (file == nullptr) {
        fprintf(stderr, "cannot read prompts from %s\n", path);
        exit(1);
    }
    char line[1 << 16];
    while (fgets(line, sizeof(line), file) != nullptr) {
        Prompt prompt;
        for (char* token = strtok(line, " \t\r\n"); token != nullptr; token = strtok(nullptr, " \t\r\n")) add_token(prompt, token);
        if (!prompt.tokens.empty() || prompt.placeholder >= 0) prompts.push_back(prompt);
    }
    fclose(file);
    return prompts;
}

// A row of the batch: the prompt it runs, what it still reads, and the pages it holds.
struct Row {
    bool running = false;
    size_t prompt = 0;
    std::vector<int64_t> pending;
    std::vector<int64_t> pages;
    int64_t length = 0;
    long generated = 0;
};

// The tensors `PageTable::step_padded` writes for `rows` reading `portions` of their pending tokens, padded to `total` rows, taking free pages as rows reach new ones.
struct Step {
    std::vector<int64_t> tokens, positions, write_pages, write_slots, query_offsets, page_offsets, pages, last_page_lengths, last_rows,
        real_tokens, sequence_ids;
};

static Step paged_step(std::vector<Row>& rows, std::vector<int64_t>& free, const std::vector<int64_t>& portions, int64_t total) {
    Step step;
    int64_t taken = 0;
    size_t padded = 0;
    for (size_t row = 0; row < rows.size(); ++row) {
        taken += std::max<int64_t>(portions[row], 1);
        if (portions[row] > 0) padded = row;
    }
    const int64_t padding = total - taken;
    std::vector<int64_t> visible;
    step.query_offsets.push_back(0);
    for (size_t index = 0; index < rows.size(); ++index) {
        Row& row = rows[index];
        for (int64_t token = 0; token < portions[index]; ++token) {
            const size_t page = static_cast<size_t>(row.length / page_size);
            if (page == row.pages.size()) {
                row.pages.push_back(free.back());
                free.pop_back();
            }
            step.tokens.push_back(row.pending[static_cast<size_t>(token)]);
            step.positions.push_back(row.length);
            step.write_pages.push_back(row.pages[page]);
            step.write_slots.push_back(row.length % page_size);
            ++row.length;
        }
        if (portions[index] == 0) {
            step.tokens.push_back(0);
            step.positions.push_back(std::min(row.length, capacity - 1));
            step.write_pages.push_back(scratch_page);
            step.write_slots.push_back(0);
        }
        const int64_t last = static_cast<int64_t>(step.tokens.size()) - 1;
        int64_t keys = row.length;
        // Padding follows the last row with tokens, as further queries whose keys count toward its length in this step alone.
        if (index == padded) {
            for (int64_t position = row.length; position < row.length + padding; ++position) {
                step.tokens.push_back(0);
                step.positions.push_back(std::min(position, capacity - 1));
                step.write_pages.push_back(scratch_page);
                step.write_slots.push_back(position % page_size);
            }
            keys += padding;
        }
        visible.push_back(keys);
        step.query_offsets.push_back(static_cast<int64_t>(step.tokens.size()));
        step.last_rows.push_back(last);
        step.real_tokens.push_back(portions[index]);
        step.sequence_ids.resize(step.tokens.size(), static_cast<int64_t>(index));
    }
    step.page_offsets.push_back(0);
    for (size_t index = 0; index < rows.size(); ++index) {
        const int64_t seen = visible[index];
        if (seen == 0) {
            // An idle row reads the scratch page, since every attention kernel takes a key.
            step.pages.push_back(scratch_page);
            step.last_page_lengths.push_back(1);
        } else {
            const int64_t used = (seen - 1) / page_size + 1;
            const int64_t held = std::min<int64_t>(used, static_cast<int64_t>(rows[index].pages.size()));
            for (int64_t page = 0; page < used; ++page) step.pages.push_back(page < held ? rows[index].pages[static_cast<size_t>(page)] : scratch_page);
            step.last_page_lengths.push_back((seen - 1) % page_size + 1);
        }
        step.page_offsets.push_back(static_cast<int64_t>(step.pages.size()));
    }
    step.pages.resize(static_cast<size_t>(table_length), 0);
    return step;
}

int main(int argc, char** argv) {
    int argument = 1;
    long long seed = 0;
    if (argument + 1 < argc && strcmp(argv[argument], "--seed") == 0) {
        seed = strtoll(argv[argument + 1], nullptr, 10);
        argument += 2;
    }
    if (argc < argument + @arguments@) {
        fprintf(stderr, "usage: %s @usage@\n", argv[0]);
        return 2;
    }
    const long new_tokens = strtol(argv[argument++], nullptr, 10);
@source_argument@    std::vector<Prompt> prompts;
    if (strcmp(argv[argument], "--prompts") == 0) {
        if (argument + 1 >= argc) {
            fprintf(stderr, "usage: %s @usage@\n", argv[0]);
            return 2;
        }
        prompts = read_prompts(argv[argument + 1]);
    } else {
        Prompt prompt;
        for (; argument < argc; ++argument) add_token(prompt, argv[argument]);
        prompts.push_back(prompt);
    }
@weights@    @prefix@_state* state = nullptr;
    check(@prefix@_create(&state), "@prefix@_create");
    check(@prefix@_load_weights(state, weights.empty() ? nullptr : weights.data()), "@prefix@_load_weights");
@seed@    (void)seed;
@structs@
@buffers@
@allocations@
    // How many copies of a prompt's starred token it holds: as many rows as the encode step gives, or one.
    int64_t placeholder_rows = 1;
@encode@    for (Prompt& prompt : prompts) {
        if (prompt.placeholder >= 0) prompt.tokens.insert(prompt.tokens.begin() + static_cast<long>(prompt.placeholder_at), placeholder_rows, prompt.placeholder);
    }

    std::vector<Row> rows(static_cast<size_t>(sequences));
    std::vector<int64_t> free;
    for (int64_t page = scratch_page - 1; page >= 0; --page) free.push_back(page);
    std::vector<int64_t> chosen(static_cast<size_t>(sequences));
    size_t next = 0, finished = 0;
    while (finished < prompts.size()) {
        for (Row& row : rows) {
            if (!row.running && next < prompts.size()) {
                row = Row();
                row.running = true;
                row.prompt = next;
                row.pending = prompts[next++].tokens;
            }
        }

        // A token per running row, and up to `largest` more for the first rows that have them, as `step_portions` gives.
        int64_t extra = 0;
        for (const Row& row : rows) extra += row.running ? std::max<int64_t>(static_cast<int64_t>(row.pending.size()) - 1, 0) : 0;
        extra = std::min(extra, largest);
        std::vector<int64_t> portions(rows.size(), 0);
        std::vector<int64_t> first(rows.size(), 0);
        int64_t taken = 0;
        for (size_t index = 0; index < rows.size(); ++index) {
            Row& row = rows[index];
            if (!row.running) {
                ++taken;
                continue;
            }
            const int64_t pending = static_cast<int64_t>(row.pending.size());
            const int64_t more = std::min(std::max<int64_t>(pending - 1, 0), extra);
            extra -= more;
            portions[index] = std::min<int64_t>(pending, 1) + more;
            // A sequence past its capacity ends, as a decoder refuses to extend it.
            if (row.length + portions[index] > capacity) {
                row.running = false;
                free.insert(free.end(), row.pages.rbegin(), row.pages.rend());
                ++finished;
                portions[index] = 0;
                ++taken;
                continue;
            }
            first[index] = row.generated == 0 && pending == portions[index];
            taken += std::max<int64_t>(portions[index], 1);
        }
        if (finished == prompts.size()) break;

        const bool decode = taken == sequences;
        const Step step = paged_step(rows, free, portions, decode ? sequences : prompt_rows);
        const void* step_tokens = nullptr;
@steps@
        check_cuda(cudaMemcpy(chosen.data(), step_tokens, chosen.size() * sizeof(int64_t), cudaMemcpyDeviceToHost), "cudaMemcpy");
        for (size_t index = 0; index < rows.size(); ++index) {
            Row& row = rows[index];
            if (!row.running) continue;
            row.pending.erase(row.pending.begin(), row.pending.begin() + portions[index]);
            if (!row.pending.empty()) continue;

            const int64_t token = chosen[index];
            ++row.generated;
            if (prompts.size() == 1) {
                printf("%lld\n", static_cast<long long>(token));
            } else {
                printf("%zu %lld\n", row.prompt, static_cast<long long>(token));
            }
            fflush(stdout);
            const bool stop = std::find(stop_tokens.begin(), stop_tokens.end(), token) != stop_tokens.end();
            if (row.generated >= new_tokens || stop) {
                row.running = false;
                free.insert(free.end(), row.pages.rbegin(), row.pages.rend());
                ++finished;
            } else {
                row.pending.push_back(token);
            }
        }
    }
    @prefix@_destroy(state);
@frees@
    return 0;
}
