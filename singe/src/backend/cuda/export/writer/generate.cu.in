// Generated by Singe.
// Generates through `@prefix@.h` with nothing else, as Singe's `RunningBatch` does: each row reads a prompt, then the token the program chose after each step, until a stop token or NEW_TOKENS tokens, and a free row takes the next prompt.
// Run it as `@prefix@_generate @usage@` beside `@prefix@.weights`, and `@prefix@.tokenizer` if the export wrote one.
// A prompt is its tokens, or with a tokenizer that encodes, its text, which goes inside the export's template unless `--raw` is given, and `--tokens` reads tokens again; `--prompts FILE` reads a prompt from each line of a file, where text writes `\n` for a line break and `\\` for a backslash.
// A token written `TOKEN*` stands for as many copies as the encode step gives its source rows, as the first of the template's placeholder token does in text.
// With a tokenizer, one prompt prints its text as it completes, and several print each prompt's text when it ends, after its number in brackets; `--ids`, or no tokenizer, prints a token per line instead, and with several prompts each token after its prompt's number, from zero.
// `--seed N` starts the draws of a program that samples, zero if it is not given.
// Each decoding step replays as a CUDA graph after its first run, unless the program samples, whose draws its run sets on the host, or `--stream` asks for every step to launch on the stream; `--time` says how long the steps took.
// A model with an encode step reads SOURCE, a file of its input's bytes, encodes it once, and then decodes one prompt.
// `@prefix@_generate --encode [--raw] (PROMPT... | --prompts FILE)` prints each prompt's tokens on a line, and generates nothing.
#include <cuda_fp16.h>
#include <cuda_runtime.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <algorithm>
#include <array>
#include <chrono>
#include <string>
#include <unordered_map>
#include <unordered_set>
#include <utility>
#include <vector>

#include "@prefix@.h"

// Where `PageTable` places tokens: each sequence takes free pages of `page_size` slots, and held rows and padding write the scratch page after them.
static const int64_t sequences = @sequences@;
static const int64_t page_size = @page_size@;
static const int64_t capacity = @capacity@;
static const int64_t scratch_page = @scratch_page@;
static const int64_t table_length = @table_length@;
// The most prompt tokens a step reads past one per row, and that step's rows.
static const int64_t largest = @largest@;
static const int64_t prompt_rows = @prompt_rows@;
// The most 64-bit words a step uploads.
static const size_t staging_words = @staging_words@;
// The tokens that end a sequence, which it prints as its last.
static const std::vector<int64_t> stop_tokens = {@stop_tokens@};
// The file of the tokenizer, empty if the export wrote none.
static const char* const tokenizer_path = "@tokenizer@";

static void check(int status, const char* what) {
    if (status != 0) {
        fprintf(stderr, "%s returned %d: %s\n", what, status, @prefix@_failure());
        exit(1);
    }
}

// Whether a program's steps draw samples, with the generator state their run sets on the host, which a graph would replay unchanged.
static const bool samples = @samples@;

static void check_cuda(cudaError_t status, const char* what) {
    if (status != cudaSuccess) {
        fprintf(stderr, "%s failed: %s\n", what, cudaGetErrorString(status));
        exit(1);
    }
}

static void* device_zeroed(unsigned long long bytes) {
    void* pointer = nullptr;
    if (bytes > 0) {
        check_cuda(cudaMalloc(&pointer, bytes), "cudaMalloc");
        check_cuda(cudaMemset(pointer, 0, bytes), "cudaMemset");
    }
    return pointer;
}

static void upload(void* buffer, const std::vector<int64_t>& values) {
    check_cuda(cudaMemcpy(buffer, values.data(), values.size() * sizeof(int64_t), cudaMemcpyHostToDevice), "cudaMemcpy");
}

// Reads `bytes` bytes of `path`, or with `exact` false up to that many.
static std::vector<char> read_file(const char* path, unsigned long long bytes, bool exact = true) {
    std::vector<char> contents(bytes);
    FILE* file = fopen(path, "rb");
    const size_t read = file == nullptr ? 0 : fread(contents.data(), 1, bytes, file);
    if (file == nullptr || (exact && read != bytes)) {
        fprintf(stderr, "cannot read %llu bytes from %s\n", bytes, path);
        exit(1);
    }
    fclose(file);
    contents.resize(read);
    return contents;
}

@graph_replay_code@
@tokenizer_code@
@prompt_code@
@paged_step_code@
int main(int argc, char** argv) {
    int argument = 1;
    long long seed = 0;
    bool print_ids = false, raw = false, read_tokens = false, encode_only = false, on_stream = false, timed = false;
    for (; argument < argc && strncmp(argv[argument], "--", 2) == 0 && strcmp(argv[argument], "--prompts") != 0; ++argument) {
        if (strcmp(argv[argument], "--seed") == 0 && argument + 1 < argc) {
            seed = strtoll(argv[++argument], nullptr, 10);
        } else if (strcmp(argv[argument], "--ids") == 0) {
            print_ids = true;
        } else if (strcmp(argv[argument], "--raw") == 0) {
            raw = true;
        } else if (strcmp(argv[argument], "--tokens") == 0) {
            read_tokens = true;
        } else if (strcmp(argv[argument], "--encode") == 0) {
            encode_only = true;
        } else if (strcmp(argv[argument], "--stream") == 0) {
            on_stream = true;
        } else if (strcmp(argv[argument], "--time") == 0) {
            timed = true;
        } else {
            break;
        }
    }
    const bool has_tokenizer = tokenizer_path[0] != '\0';
    const Tokenizer tokenizer = has_tokenizer ? load_tokenizer() : Tokenizer();
    const bool reads_text = tokenizer.encodes && !read_tokens;
    if ((raw || encode_only) && !tokenizer.encodes) {
        fprintf(stderr, "this loop's tokenizer reads no text\n");
        return 2;
    }
    if (argc < argument + (encode_only ? 1 : @arguments@)) {
        fprintf(stderr, "usage: %s @usage@\n   or: %s --encode [--raw] (PROMPT... | --prompts FILE)\n", argv[0], argv[0]);
        return 2;
    }
    const long new_tokens = encode_only ? 0 : strtol(argv[argument++], nullptr, 10);
@source_argument@    std::vector<Prompt> prompts;
    if (strcmp(argv[argument], "--prompts") == 0) {
        if (argument + 1 >= argc) {
            fprintf(stderr, "usage: %s @usage@\n", argv[0]);
            return 2;
        }
        for (const std::string& line : read_lines(argv[argument + 1], reads_text)) prompts.push_back(reads_text ? text_prompt(tokenizer, line, raw) : token_prompt(line));
    } else {
        std::string line;
        for (; argument < argc; ++argument) line += (line.empty() ? "" : " ") + std::string(argv[argument]);
        prompts.push_back(reads_text ? text_prompt(tokenizer, line, raw) : token_prompt(line));
    }
    if (encode_only) {
        for (const Prompt& prompt : prompts) {
            for (size_t index = 0; index <= prompt.tokens.size(); ++index) {
                if (prompt.placeholder >= 0 && index == prompt.placeholder_at) printf("%lld* ", static_cast<long long>(prompt.placeholder));
                if (index < prompt.tokens.size()) printf("%lld ", static_cast<long long>(prompt.tokens[index]));
            }
            printf("\n");
        }
        return 0;
    }
    // Text prints with a tokenizer unless `--ids` asks for tokens: each prompt's bytes wait in `pending` until they complete characters.
    const bool print_text = has_tokenizer && !print_ids;
    std::vector<std::string> pending(prompts.size()), texts(prompts.size());
@weights@    @prefix@_state* state = nullptr;
    check(@prefix@_create(&state), "@prefix@_create");
    check(@prefix@_load_weights(state, weights.empty() ? nullptr : weights.data()), "@prefix@_load_weights");
    check_cuda(cudaStreamCreate(&loop_stream), "cudaStreamCreate");
    use_graphs = !samples && !on_stream;
    // The decode step's graph and the prompt step's.
    StepGraph step_graphs[2];
    // How many decode and prompt steps ran, and how long they took, in seconds.
    long step_counts[2] = {0, 0};
    double step_seconds[2] = {0.0, 0.0};
@seed@    (void)seed;
@structs@
@buffers@
@allocations@
    // How many copies of a prompt's starred token it holds: as many rows as the encode step gives, or one.
    int64_t placeholder_rows = 1;
@encode@    for (Prompt& prompt : prompts) {
        if (prompt.placeholder >= 0) prompt.tokens.insert(prompt.tokens.begin() + static_cast<long>(prompt.placeholder_at), placeholder_rows, prompt.placeholder);
    }

    std::vector<Row> rows(static_cast<size_t>(sequences));
    std::vector<int64_t> free;
    for (int64_t page = scratch_page - 1; page >= 0; --page) free.push_back(page);
    size_t next_prompt = 0, finished = 0;
    // Frees a row whose sequence has ended, and prints the rest of its text.
    const auto end_sequence = [&](Row& row) {
        row.running = false;
        free.insert(free.end(), row.pages.rbegin(), row.pages.rend());
        ++finished;
        if (!print_text) return;
        take_text(pending[row.prompt], texts[row.prompt], true);
        if (prompts.size() == 1) {
            printf("%s\n", texts[row.prompt].c_str());
        } else {
            printf("[%zu] %s\n", row.prompt, texts[row.prompt].c_str());
        }
        fflush(stdout);
    };
    // Two of each, since a step is staged and launched while the host reads the one before it.
    int64_t* staging[2] = {nullptr, nullptr};
    int64_t* chosen[2] = {nullptr, nullptr};
    cudaEvent_t read[2], started[2], ended[2];
    for (int parity = 0; parity < 2; ++parity) {
        check_cuda(cudaMallocHost(&staging[parity], staging_words * sizeof(int64_t)), "cudaMallocHost");
        check_cuda(cudaMallocHost(&chosen[parity], static_cast<size_t>(sequences) * sizeof(int64_t)), "cudaMallocHost");
        check_cuda(cudaEventCreate(&read[parity]), "cudaEventCreate");
        check_cuda(cudaEventCreate(&started[parity]), "cudaEventCreate");
        check_cuda(cudaEventCreate(&ended[parity]), "cudaEventCreate");
    }
    bool ran[2] = {false, false};
    long launches = 0;
    // Enqueues the next step, as `RunningBatch` does: a row reads its pending tokens, or after `previous`, the token `previous` chose for it, on the device, if it may take another.
    const auto enqueue_step = [&](const UnreadStep* previous, UnreadStep& unread) -> bool {
        std::vector<std::vector<int64_t>> reads(rows.size());
        std::vector<bool> awaiting(rows.size(), false);
        for (size_t index = 0; index < rows.size(); ++index) {
            const Row& row = rows[index];
            if (!row.running) continue;
            awaiting[index] = previous != nullptr && previous->choosing[index] == static_cast<long long>(row.prompt);
            if (!row.pending.empty()) {
                reads[index] = row.pending;
            } else if (awaiting[index] && row.generated + 1 < new_tokens) {
                reads[index] = {-1};
            }
        }

        // A token per reading row, and up to `largest` more for the first rows that have them, as `step_portions` gives.
        int64_t extra = 0;
        for (const std::vector<int64_t>& tokens : reads) extra += std::max<int64_t>(static_cast<int64_t>(tokens.size()) - 1, 0);
        extra = std::min(extra, largest);
        std::vector<int64_t> first_tokens(rows.size(), 0);
        std::vector<long long> choosing(rows.size(), -1);
        int64_t taken = 0;
        bool any = false;
        for (size_t index = 0; index < rows.size(); ++index) {
            Row& row = rows[index];
            const int64_t length = static_cast<int64_t>(reads[index].size());
            if (length == 0) {
                ++taken;
                continue;
            }
            const int64_t more = std::min(std::max<int64_t>(length - 1, 0), extra);
            extra -= more;
            const int64_t portion = std::min<int64_t>(length, 1) + more;
            // A sequence past its capacity ends, as a decoder refuses to extend it, once the token it awaits is read.
            if (row.length + portion > capacity) {
                if (!awaiting[index]) end_sequence(row);
                reads[index].clear();
                ++taken;
                continue;
            }
            reads[index].resize(static_cast<size_t>(portion));
            if (portion == length) choosing[index] = static_cast<long long>(row.prompt);
            first_tokens[index] = choosing[index] >= 0 && row.generated + (awaiting[index] ? 1 : 0) == 0;
            taken += portion;
            any = true;
        }
        if (!any) return false;

        const bool decode = taken == sequences;
        const Step step = paged_step(rows, free, reads, decode ? sequences : prompt_rows);
        for (size_t index = 0; index < rows.size(); ++index) {
            Row& row = rows[index];
            const size_t read_tokens = std::min(reads[index].size(), row.pending.size());
            row.pending.erase(row.pending.begin(), row.pending.begin() + static_cast<long>(read_tokens));
        }
        const int parity = static_cast<int>(launches++ % 2);
        const void* step_tokens = nullptr;
        check_cuda(cudaEventRecord(started[parity], loop_stream), "cudaEventRecord");
@steps@
        check_cuda(cudaEventRecord(ended[parity], loop_stream), "cudaEventRecord");
        unread.active = true;
        unread.decode = decode;
        unread.parity = parity;
        unread.tokens = step_tokens;
        unread.choosing = choosing;
        return true;
    };
    const auto loop_started = std::chrono::steady_clock::now();
    UnreadStep previous;
    while (finished < prompts.size()) {
        for (Row& row : rows) {
            if (!row.running && next_prompt < prompts.size()) {
                row = Row();
                row.running = true;
                row.prompt = next_prompt;
                row.pending = prompts[next_prompt++].tokens;
            }
        }
        if (!previous.active && !enqueue_step(nullptr, previous)) continue;

        // The next step reads these tokens on the device and runs while the host reads them; a sequence that stopped leaves its row of it unread.
        check_cuda(cudaMemcpyAsync(chosen[previous.parity], previous.tokens, static_cast<size_t>(sequences) * sizeof(int64_t), cudaMemcpyDeviceToHost, loop_stream), "cudaMemcpyAsync");
        check_cuda(cudaEventRecord(read[previous.parity], loop_stream), "cudaEventRecord");
        UnreadStep next;
        enqueue_step(&previous, next);
        check_cuda(cudaEventSynchronize(read[previous.parity]), "cudaEventSynchronize");
        float milliseconds = 0.0F;
        check_cuda(cudaEventElapsedTime(&milliseconds, started[previous.parity], ended[previous.parity]), "cudaEventElapsedTime");
        ++step_counts[previous.decode ? 0 : 1];
        step_seconds[previous.decode ? 0 : 1] += milliseconds / 1000.0;
        for (size_t index = 0; index < rows.size(); ++index) {
            Row& row = rows[index];
            if (!row.running || previous.choosing[index] != static_cast<long long>(row.prompt)) continue;

            const int64_t token = chosen[previous.parity][index];
            ++row.generated;
            if (!print_text) {
                if (prompts.size() == 1) {
                    printf("%lld\n", static_cast<long long>(token));
                } else {
                    printf("%zu %lld\n", row.prompt, static_cast<long long>(token));
                }
            } else if (token >= 0 && static_cast<size_t>(token) < tokenizer.bytes.size() && !tokenizer.special[static_cast<size_t>(token)]) {
                pending[row.prompt] += tokenizer.bytes[static_cast<size_t>(token)];
                take_text(pending[row.prompt], texts[row.prompt], false);
                if (prompts.size() == 1) {
                    fputs(texts[row.prompt].c_str(), stdout);
                    texts[row.prompt].clear();
                }
            }
            fflush(stdout);
            const bool stop = std::find(stop_tokens.begin(), stop_tokens.end(), token) != stop_tokens.end();
            if (row.generated >= new_tokens || stop) {
                end_sequence(row);
            } else if (!next.active || next.choosing[index] != static_cast<long long>(row.prompt)) {
                row.pending.push_back(token);
            }
        }
        previous = next;
    }
    check_cuda(cudaStreamSynchronize(loop_stream), "cudaStreamSynchronize");
    const double loop_seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - loop_started).count();
@finish@
    if (timed) {
        for (int kind = 0; kind < 2; ++kind) {
            if (step_counts[kind] > 0) fprintf(stderr, "%s steps: %ld, %.3f ms each on the device\n", kind == 0 ? "decode" : "prompt", step_counts[kind], 1000.0 * step_seconds[kind] / static_cast<double>(step_counts[kind]));
        }
        const long steps = step_counts[0] + step_counts[1];
        if (steps > 0) fprintf(stderr, "steps: %ld, %.3f ms each from the first launch to the last read\n", steps, 1000.0 * loop_seconds / static_cast<double>(steps));
    }
    for (int parity = 0; parity < 2; ++parity) {
        cudaFreeHost(staging[parity]);
        cudaFreeHost(chosen[parity]);
        cudaEventDestroy(read[parity]);
        cudaEventDestroy(started[parity]);
        cudaEventDestroy(ended[parity]);
    }
    for (StepGraph& graph : step_graphs) {
        if (graph.exec != nullptr) cudaGraphExecDestroy(graph.exec);
    }
    cudaStreamDestroy(loop_stream);
    @prefix@_destroy(state);
@frees@
    return 0;
}
