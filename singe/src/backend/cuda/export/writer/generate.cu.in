        fprintf(stderr, "%s returned %d: %s\n", what, status, @prefix@_failure());
        exit(1);
    }
}

static void check_cuda(cudaError_t status, const char* what) {
    if (status != cudaSuccess) {
        fprintf(stderr, "%s failed: %s\n", what, cudaGetErrorString(status));
        exit(1);
    }
}

static void* device_zeroed(unsigned long long bytes) {
    void* pointer = nullptr;
    if (bytes > 0) {
        check_cuda(cudaMalloc(&pointer, bytes), "cudaMalloc");
        check_cuda(cudaMemset(pointer, 0, bytes), "cudaMemset");
    }
    return pointer;
}

static void upload(void* buffer, const int64_t* values, size_t count) {
    check_cuda(cudaMemcpy(buffer, values, count * sizeof(int64_t), cudaMemcpyHostToDevice), "cudaMemcpy");
}

static std::vector<char> read_file(const char* path, unsigned long long bytes) {
    std::vector<char> contents(bytes);
    FILE* file = fopen(path, "rb");
    if (file == nullptr || fread(contents.data(), 1, bytes, file) != bytes) {
        fprintf(stderr, "cannot read %llu bytes from %s\n", bytes, path);
        exit(1);
    }
    fclose(file);
    return contents;
}

static float logit(@logit_type@ value) {
@logit_conversion@}

int main(int argc, char** argv) {
    if (argc < @first_token@ + 1) {
        fprintf(stderr, "usage: %s @usage@\n", argv[0]);
        return 2;
    }
    const long new_tokens = strtol(argv[1], nullptr, 10);
    std::vector<int64_t> sequence;
    for (int argument = @first_token@; argument < argc; ++argument) sequence.push_back(strtoll(argv[argument], nullptr, 10));
@weights@    @prefix@_state* state = nullptr;
    check(@prefix@_create(&state), "@prefix@_create");
    check(@prefix@_load_weights(state, weights.empty() ? nullptr : weights.data()), "@prefix@_load_weights");
@structs@
@buffers@
@allocations@
@encode@    const int64_t prompt = static_cast<int64_t>(sequence.size());
    std::vector<@logit_type@> logits(@logit_count@);
    std::vector<int64_t> pages(table_length, 0);
    long generated = 0;
    for (int64_t position = 0; position < capacity && generated < new_tokens; ++position) {
        // The paging tensors `PageTable::step` writes for one token of one sequence at `position`.
        const int64_t used = position / page_size + 1;
        for (int64_t page = 0; page < used; ++page) pages[page] = page;
        const int64_t token = sequence[position];
        const int64_t write_page = position / page_size;
        const int64_t write_slot = position % page_size;
        const int64_t query_offsets[2] = {0, 1};
        const int64_t page_offsets[2] = {0, used};
        const int64_t last_page_length = position % page_size + 1;
        const int64_t last_row = 0;
        upload(@tokens@, &token, 1);
        upload(@positions@, &position, 1);
        upload(@write_pages@, &write_page, 1);
        upload(@write_slots@, &write_slot, 1);
        upload(@query_offsets@, query_offsets, 2);
        upload(@page_offsets@, page_offsets, 2);
        upload(@pages@, pages.data(), pages.size());
        upload(@last_page_lengths@, &last_page_length, 1);
        upload(@last_rows@, &last_row, 1);
        check(@run@(state, &inputs, &outputs, nullptr), "@run@");
        unsigned int word = 0;
        check(@finish@(state, nullptr, &word), "@finish@");
        if (word != 0) {
            fprintf(stderr, "a checking kernel reported %u\n", word);
            return 1;
        }
        if (position + 1 < prompt) continue;

        check_cuda(cudaMemcpy(logits.data(), @logits@, logits.size() * sizeof(logits[0]), cudaMemcpyDeviceToHost), "cudaMemcpy");
        size_t best = 0;
        for (size_t index = 1; index < logits.size(); ++index) {
            if (logit(logits[index]) > logit(logits[best])) best = index;
        }
        const int64_t next = static_cast<int64_t>(best);
        printf("%lld\n", static_cast<long long>(next));
        fflush(stdout);
        sequence.push_back(next);
        ++generated;
    }
    @prefix@_destroy(state);
@frees@
    return 0;
}
