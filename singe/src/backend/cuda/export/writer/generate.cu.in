// Where `PageTable` places one sequence's tokens: positions fill pages from page zero, `page_size` slots each, and padding writes the scratch page after them.
static const int64_t page_size = @page_size@;
static const int64_t capacity = @capacity@;
static const int64_t scratch_page = @scratch_page@;
static const int64_t table_length = @table_length@;

static void check(int status, const char* what) {
    if (status != 0) {
        fprintf(stderr, "%s returned %d: %s\n", what, status, @prefix@_failure());
        exit(1);
    }
}

static void check_cuda(cudaError_t status, const char* what) {
    if (status != cudaSuccess) {
        fprintf(stderr, "%s failed: %s\n", what, cudaGetErrorString(status));
        exit(1);
    }
}

static void* device_zeroed(unsigned long long bytes) {
    void* pointer = nullptr;
    if (bytes > 0) {
        check_cuda(cudaMalloc(&pointer, bytes), "cudaMalloc");
        check_cuda(cudaMemset(pointer, 0, bytes), "cudaMemset");
    }
    return pointer;
}

static void upload(void* buffer, const std::vector<int64_t>& values) {
    check_cuda(cudaMemcpy(buffer, values.data(), values.size() * sizeof(int64_t), cudaMemcpyHostToDevice), "cudaMemcpy");
}

static std::vector<char> read_file(const char* path, unsigned long long bytes) {
    std::vector<char> contents(bytes);
    FILE* file = fopen(path, "rb");
    if (file == nullptr || fread(contents.data(), 1, bytes, file) != bytes) {
        fprintf(stderr, "cannot read %llu bytes from %s\n", bytes, path);
        exit(1);
    }
    fclose(file);
    return contents;
}

static float logit(@logit_type@ value) {
@logit_conversion@}

// The tensors `PageTable::step_padded` writes for one sequence reading `real` tokens of `sequence` from `start`, padded to `rows` rows.
struct Step {
    std::vector<int64_t> tokens, positions, write_pages, write_slots, query_offsets, page_offsets, pages, last_page_lengths, last_rows,
        real_tokens, sequence_ids;
};

static Step paged_step(const std::vector<int64_t>& sequence, int64_t start, int64_t real, int64_t rows) {
    Step step;
    for (int64_t row = 0; row < rows; ++row) {
        const int64_t position = start + row;
        const bool own = row < real;
        step.tokens.push_back(own ? sequence[position] : 0);
        step.positions.push_back(std::min(position, capacity - 1));
        step.write_pages.push_back(own ? position / page_size : scratch_page);
        step.write_slots.push_back(position % page_size);
        step.sequence_ids.push_back(0);
    }
    // Padding's keys count toward the sequence's in this step alone, and those past its own pages read the scratch page.
    const int64_t keys = start + rows;
    const int64_t used = (keys - 1) / page_size + 1;
    const int64_t held = (start + real - 1) / page_size + 1;
    for (int64_t page = 0; page < used; ++page) step.pages.push_back(page < held ? page : scratch_page);
    step.pages.resize(table_length, 0);
    step.query_offsets = {0, rows};
    step.page_offsets = {0, used};
    step.last_page_lengths = {(keys - 1) % page_size + 1};
    step.last_rows = {real - 1};
    step.real_tokens = {real};
    return step;
}

int main(int argc, char** argv) {
    if (argc < @first_token@ + 1) {
        fprintf(stderr, "usage: %s @usage@\n", argv[0]);
        return 2;
    }
    const long new_tokens = strtol(argv[1], nullptr, 10);
    std::vector<int64_t> sequence;
    for (int argument = @first_token@; argument < argc; ++argument) sequence.push_back(strtoll(argv[argument], nullptr, 10));
@weights@    @prefix@_state* state = nullptr;
    check(@prefix@_create(&state), "@prefix@_create");
    check(@prefix@_load_weights(state, weights.empty() ? nullptr : weights.data()), "@prefix@_load_weights");
@structs@
@buffers@
@allocations@
@encode@    const int64_t prompt = static_cast<int64_t>(sequence.size());
    std::vector<@logit_type@> logits(@logit_count@);
    long generated = 0;
    int64_t length = 0;
    while (length < capacity && generated < new_tokens) {
        // A prompt step reads all but one of the pending prompt tokens it holds, padded to its rows, as `RunningBatch` gives a step a token per row and up to its largest prompt step's more.
        const int64_t pending = std::max<int64_t>(prompt - length, 1);
        const void* step_logits = nullptr;
@steps@
        if (length < prompt) continue;

        check_cuda(cudaMemcpy(logits.data(), step_logits, logits.size() * sizeof(logits[0]), cudaMemcpyDeviceToHost), "cudaMemcpy");
        size_t best = 0;
        for (size_t index = 1; index < logits.size(); ++index) {
            if (logit(logits[index]) > logit(logits[best])) best = index;
        }
        const int64_t next = static_cast<int64_t>(best);
        printf("%lld\n", static_cast<long long>(next));
        fflush(stdout);
        sequence.push_back(next);
        ++generated;
    }
    @prefix@_destroy(state);
@frees@
    return 0;
}
