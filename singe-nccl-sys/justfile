nccl_include_path := "$NCCL_INCLUDE_PATH"
cuda_path := "$CUDA_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    num_enums=(
        "ncclResult_t"
        "ncclRedOp_t"
        "ncclDataType_t"
        "ncclScalarResidence_t"
        "ncclHostCftMode_t"
    )
    enum_args=$(for enum in "${num_enums[@]}"; do echo -n "--with-derive-custom $enum=TryFromPrimitive,IntoPrimitive "; done)

    bindgen {{nccl_include_path}}/nccl.h \
        $enum_args \
        --allowlist-item "^nccl.*" \
        --allowlist-item "^NCCL.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUstream_st$" \
        --blocklist-item "^dim3$" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=rust \
        -- \
            -fparse-all-comments \
            -fretain-comments-from-system-headers \
            -I {{cuda_path}}/include \
            -I {{nccl_include_path}} \
            -include nccl_device/host.h \
        > bindings.rs

    NCCL_VERSION=$(awk '/^pub const NCCL_VERSION_CODE:/ { sub(/;$/, "", $6); print $6 }' bindings.rs)
    if [ -z "${NCCL_VERSION}" ]; then
        echo "NCCL_VERSION is empty"
        exit 1
    fi

    mv bindings.rs ./src/sys_${NCCL_VERSION}.rs

clean:
    rm -rf ./dist
    rm -f ./src/sys_*.rs
