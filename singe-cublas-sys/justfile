cuda_path := "$CUDA_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    bindgen {{cuda_path}}/include/cublas_v2.h \
        --allowlist-item "^cublas.*" \
        --allowlist-item "^CUBLAS.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^libraryPropertyType.*" \
        --allowlist-file ".*[^\w]cublas_api.h" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -I {{cuda_path}}/include \
        > bindings.rs

    CUBLAS_VERSION=$(cat bindings.rs | grep "CUBLAS_VERSION" | awk '{ print $6 }' | sed 's/.$//')
    if [ -z "${CUBLAS_VERSION}" ]; then
        echo "CUBLAS_VERSION is empty"
        exit 1
    fi

    grep -v "pub use self::cudaDataType as cublasDataType_t;" bindings.rs > bindings2.rs
    rm bindings.rs

    mv bindings2.rs ./src/sys_${CUBLAS_VERSION}.rs

    bindgen {{cuda_path}}/include/cublasLt.h \
        --allowlist-item "^cublasLt.*" \
        --allowlist-item "^CUBLASLT.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^libraryPropertyType.*" \
        --blocklist-item "^cublasStatus_t$" \
        --blocklist-item "^cublasComputeType_t$" \
        --allowlist-file ".*[^\w]cublasLt.h" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -I {{cuda_path}}/include \
        > ./src/sys_lt_${CUBLAS_VERSION}.rs

    bindgen {{cuda_path}}/include/cublasXt.h \
        --allowlist-item "^cublasXt.*" \
        --allowlist-item "^CUBLASXT.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^libraryPropertyType.*" \
        --blocklist-item "^cublasStatus_t$" \
        --blocklist-item "^cublasOperation_t$" \
        --blocklist-item "^cublasFillMode_t$" \
        --blocklist-item "^cublasSideMode_t$" \
        --blocklist-item "^cublasDiagType_t$" \
        --blocklist-item "^cuComplex$" \
        --blocklist-item "^cuDoubleComplex$" \
        --blocklist-item "^cuFloatComplex$" \
        --blocklist-item "^float2$" \
        --blocklist-item "^double2$" \
        --allowlist-file ".*[^\w]cublasXt.h" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -I {{cuda_path}}/include \
        > ./src/sys_xt_${CUBLAS_VERSION}.rs

    # Each declared function loads its symbol at run time, through singe-loader.
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { crate::LIBRARY;/' ./src/sys_[0-9]*.rs
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { crate::LIBRARY;/' ./src/sys_xt_*.rs
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { crate::LT;/' ./src/sys_lt_*.rs

clean:
    rm -rf ./dist
    rm -f ./src/sys_*.rs
