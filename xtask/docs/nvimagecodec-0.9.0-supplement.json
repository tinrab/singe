    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv426nvimgcodecProcessingStatus"
  },
  "NVIMGCODEC_PROCESSING_STATUS_SATURATED": {
    "doc": "Decoder/encoder could potentially process image but is saturated.\n\nSee also\n\n[nvimgcodecBackendParams_t](https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#structnvimgcodecBackendParams__t) load_hint.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv426nvimgcodecProcessingStatus"
  },
  "NVIMGCODEC_PROCESSING_STATUS_SUCCESS": {
    "doc": "Processing finished with success.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv426nvimgcodecProcessingStatus"
  },
  "NVIMGCODEC_PROCESSING_STATUS_TILING_UNSUPPORTED": {
    "doc": "Unsupported tiling to encode.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv426nvimgcodecProcessingStatus"
  },
  "NVIMGCODEC_QUALITY_TYPE_DEFAULT": {
    "doc": "Each plugin decides what is best quality setting to use. `quality_value `is ignored.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
  "NVIMGCODEC_QUALITY_TYPE_LOSSLESS": {
    "doc": "Image encoding is reversible and keeps original image quality. `quality_value` is ignored except for:\n\n* the CUDA TIFF encoder backend, for which `quality_value = 0` means no compression, and `quality_value = 1` means LZW compression,\n* the CPU PNG encoder backend, for which `quality_value` can be in range from 0 (lowest compression ratio, fastest) to 9 (highest compression ratio, slowest).",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
  "NVIMGCODEC_QUALITY_TYPE_PSNR": {
    "doc": "`quality_value` is interpreted as desired Peak Signal-to-Noise Ratio (PSNR) target for the encoded image. The higher the value, the better quality image is produced. Value should be positive.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
  "NVIMGCODEC_QUALITY_TYPE_QUALITY": {
    "doc": "`quality_value` is interpreted as JPEG-like quality in range from 1 (worst) to 100 (best).",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
  "NVIMGCODEC_QUALITY_TYPE_QUANTIZATION_STEP": {
    "doc": "`quality_value` is interpreted as quantization step (by how much pixel data will be divided). The higher the value, the worse quality image is produced.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
  "NVIMGCODEC_QUALITY_TYPE_SIZE_RATIO": {
    "doc": "`quality_value` is interpreted as desired encoded image size ratio compared to original size, should be floating in range (0.0, 1.0). E.g. value 0.1 means target size of 10% of original image.",
    "kind": "enum_member",
    "uri": "https://docs.nvidia.com/cuda/nvimagecodec/c_api.html#_CPPv423nvimgcodecQualityType_t"
  },
