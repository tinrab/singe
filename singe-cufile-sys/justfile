cuda_path := "$CUDA_PATH"
cufile_include_path := "$CUFILE_INCLUDE_PATH"
cufile_path := "$CUFILE_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    bindgen {{cufile_include_path}}/cufile.h \
        --allowlist-item "^cuFile.*" \
        --allowlist-item "^CUfile.*" \
        --allowlist-item "^CUFILE.*" \
        --allowlist-item "^CU_FILE.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^CUstream.*" \
        --blocklist-item "^CUresult.*" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -fparse-all-comments \
            -x c++ \
            -I {{cuda_path}}/include \
            -I {{cufile_include_path}} \
        > bindings.rs

    CUFILE_VERSION=$(
        find {{cufile_path}} -maxdepth 1 -type f -o -type l |
        sed -nE 's|.*/libcufile\.so\.([0-9]+)\.([0-9]+)\.[0-9]+$|\1 \2|p' |
        sort -n -k1,1 -k2,2 |
        tail -n1 |
        awk '{ print 1000 * $1 + 10 * $2 }'
    )
    if [ -z "${CUFILE_VERSION}" ]; then
        echo "CUFILE_VERSION is empty"
        exit 1
    fi

    mv bindings.rs ./src/sys_${CUFILE_VERSION}.rs

    # Each declared function loads its symbol at run time, through singe-loader.
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { crate::LIBRARY;/' ./src/sys_*.rs

clean:
    rm -rf ./dist
    rm -f ./src/sys_*.rs
