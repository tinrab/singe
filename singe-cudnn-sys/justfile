cuda_path := "$CUDA_PATH"
cudnn_include_path := "$CUDNN_INCLUDE_PATH"

generate:
    #!/usr/bin/env bash
    set -euxo pipefail

    bindgen "{{cudnn_include_path}}"/cudnn.h \
        --allowlist-item "^cudnn.*" \
        --allowlist-item "^CUDNN.*" \
        --blocklist-item "^cuda.*" \
        --blocklist-item "^CUDA.*" \
        --blocklist-item "^libraryPropertyType.*" \
        --allowlist-file ".*[^\w]cudnn.h" \
        --no-size_t-is-usize \
        --no-layout-tests \
        --with-derive-default \
        --with-derive-eq \
        --with-derive-hash \
        --with-derive-ord \
        --use-core \
        --default-enum-style=newtype \
        -- \
            -x c++ -fparse-all-comments -fretain-comments-from-system-headers \
            -I {{cuda_path}}/include \
        > bindings.rs

    CUDNN_VERSION=$(cat bindings.rs | grep "CUDNN_VERSION" | awk '{ print $6 }' | sed 's/.$//')
    if [ -z "${CUDNN_VERSION}" ]; then
        echo "CUDNN_VERSION is empty"
        exit 1
    fi

    mv bindings.rs ./src/sys_${CUDNN_VERSION}.rs

    # Each declared function loads its symbol at run time, through singe-loader.
    sed -i 's/^unsafe extern "C" {$/singe_loader::functions! { crate::LIBRARY;/' ./src/sys_*.rs

clean:
    rm -rf ./dist
    rm -f ./src/sys_*.rs
